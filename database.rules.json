{
  "rules": {
    ".read": false,
    ".write": false,
    "races": {
      "$raceId": {
        ".read": "$raceId.matches(/^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$/)"
      }
    },
    "jobs": {
      ".indexOn": [
        "active"
      ]
    },
    "limits": {
      ".indexOn": [
        "at"
      ]
    },
    "courses": {
      "$raceId": {
        ".read": "$raceId.matches(/^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$/)"
      }
    },
    "tracks": {
      "$raceId": {
        ".read": "$raceId.matches(/^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$/)"
      }
    },
    "slugs": {
      "$slug": {
        ".read": "$slug.matches(/^[a-z][a-z0-9-]{2,39}$/)"
      },
      ".indexOn": ".value"
    }
  }
}
