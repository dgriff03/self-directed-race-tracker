{
  "name": "milemark-race-tracker",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vite --config vite.firebase.config.ts",
    "build": "npm run build:frontend && npm run build:functions",
    "start": "vite preview --config vite.firebase.config.ts --host 127.0.0.1 --port 4173",
    "build:frontend": "vite build --config vite.firebase.config.ts && node scripts/cache-assets.mjs",
    "dev:frontend": "vite --config vite.firebase.config.ts",
    "test": "tsx --test tests/tracking.test.ts",
    "typecheck": "tsc --noEmit",
    "build:functions": "npm --prefix functions run build",
    "test:rules": "tsx --test tests/rules.test.ts",
    "test:scheduler": "node tests/scheduler.mjs",
    "test:integration": "node tests/integration.mjs",
    "test:replay": "node tests/replay-browser.mjs && node tests/replay-demo-browser.mjs",
    "test:outback": "node tests/outback-browser.mjs",
    "test:maps": "node tests/map-fallback-browser.mjs && node tests/tile-cache.mjs",
    "test:browser": "npm run test:replay && npm run test:outback && npm run test:maps && npm run test:viewer && npm run test:gpx && npm run test:directions",
    "test:viewer": "node tests/viewer-feedback-browser.mjs",
    "test:storage": "node tests/storage.mjs",
    "test:sms": "npm run build:functions && node tests/sms.mjs",
    "test:slugs": "npm run build:functions && node tests/slugs.mjs",
    "test:slug-browser": "node tests/slug-browser.mjs",
    "test:crew-departure": "node tests/crew-departure.mjs",
    "test:gpx": "node tests/gpx-waypoints-browser.mjs",
    "test:directions": "node tests/offline-directions-browser.mjs"
  },
  "dependencies": {
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "fast-xml-parser": "^5.11.1",
    "firebase": "^12.19.0",
    "lucide-react": "^1.31.0",
    "maplibre-gl": "^6.9.0",
    "radix-ui": "^1.6.7",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "tailwind-merge": "3.6.0",
    "tz-lookup": "^6.1.25",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.2",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@types/tz-lookup": "^6.1.2",
    "@vitejs/plugin-react": "6.0.2",
    "firebase-tools": "^15.30.0",
    "prettier": "^3.9.6",
    "tailwindcss": "4.2.1",
    "tsx": "^4.23.13",
    "tw-animate-css": "^1.4.0",
    "typescript": "5.9.3",
    "vite": "8.0.13"
  },
  "type": "module"
}
